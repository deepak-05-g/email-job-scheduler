# App & Environment
NODE_ENV=production
PORT=3001
API_PORT=3001
API_PUBLIC_URL=https://api.yourdomain.com
WEB_PUBLIC_URL=https://app.yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://scheduler:scheduler@127.0.0.1:5432/email_scheduler?schema=public

# Queue & Cache (Redis)
REDIS_URL=redis://127.0.0.1:6379

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth/google/callback

# Authentication & Sessions
SESSION_COOKIE_NAME=email_scheduler_session
SESSION_SECRET=your-session-secret-at-least-32-chars-long
SESSION_TTL_SECONDS=86400

# Production SMTP (Amazon SES, SendGrid, Postmark, Resend, etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key
SMTP_SECURE=false
DEFAULT_FROM_EMAIL=notifications@yourdomain.com
DEFAULT_FROM_NAME=Email Scheduler

# Development / Testing Ethereal SMTP Fallback
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your-ethereal-user
ETHEREAL_PASS=your-ethereal-pass
ETHEREAL_SECURE=false

# Worker Concurrency & Rate Limiting
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100
WORKER_STALE_PROCESSING_MS=300000

# Campaign Safety Limits
MAX_RECIPIENTS_PER_CAMPAIGN=1000
MAX_UPLOAD_BYTES=5242880

# BullMQ Queue Job Retries & Retention
EMAIL_JOB_ATTEMPTS=3
EMAIL_JOB_BACKOFF_MS=5000
COMPLETED_JOB_RETENTION_COUNT=1000
FAILED_JOB_RETENTION_COUNT=5000
